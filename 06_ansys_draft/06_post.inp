! =====================================================================
! 06_post.inp  -  results to files and images
! load_deflection.csv : every converged substep: time, total load (kN), midspan deflection (mm)
! service_tests.csv   : deflection at each service-load test (what the twin must predict)
! PNG images          : stress contours, crack pattern, bar stress, deformed shape at each
!                       damage peak and near failure
! =====================================================================
/POST1
FILE,,RST
*GET,NSETS,ACTIVE,0,SET,NSET
*DIM,LD,ARRAY,NSETS,3
CMSEL,S,SUP1
CMSEL,A,SUP2
*GET,NSUP,NODE,0,COUNT
*DIM,SUPN,ARRAY,NSUP
*VGET,SUPN(1),NODE,,NLIST
ALLSEL,ALL
*DO,S,1,NSETS
  SET,,,,,,,S
  *GET,LD(S,1),ACTIVE,0,SET,TIME
  RY = 0
  *DO,Q,1,NSUP
    *GET,R_,NODE,SUPN(Q),RF,FY
    RY = RY+R_
  *ENDDO
  LD(S,2) = 2*RY/1000          ! half model: total jack load = 2 x reactions, in kN
  *GET,U_,NODE,N_MID,U,Y
  LD(S,3) = -U_
*ENDDO
*CFOPEN,%TAG%_load_deflection,csv
*VWRITE
('time,load_kN,midspan_deflection_mm')
*VWRITE,LD(1,1),LD(1,2),LD(1,3)
(F10.4,',',F12.4,',',F12.5)
*CFCLOS

! ---------- service tests: deflection increment from the start to the top of each service cycle
*DIM,SV,ARRAY,10,3
*DO,Q,1,N_SRV
  SET,LS_SRV(Q)-1,LAST
  *GET,U1,NODE,N_MID,U,Y
  SET,LS_SRV(Q),LAST
  *GET,U2,NODE,N_MID,U,Y
  SV(Q,1) = LS_SRV(Q)
  SV(Q,2) = P_SERV
  SV(Q,3) = U1-U2
*ENDDO
*CFOPEN,%TAG%_service_tests,csv
*VWRITE
('load_step,service_load_kN,deflection_increment_mm')
*VWRITE,SV(1,1),SV(1,2),SV(1,3)
(F6.0,',',F8.2,',',F12.5)
*CFCLOS

! ---------- images
/SHOW,PNG
/GFILE,1600
/VIEW,1,1,1,1
/DSCALE,1,AUTO
/PLOPTS,INFO,ON
*DO,Q,1,N_DMG
  *IF,LS_DMG(Q),GT,0,THEN
    SET,LS_DMG(Q),LAST
    /TITLE,Longitudinal stress at %P_DMG(Q)% kN
    PLNSOL,S,X
    *IF,CONC,EQ,1,THEN
      /TITLE,Crack pattern at %P_DMG(Q)% kN
      PLCRACK,1
    *ELSE
      /TITLE,Equivalent plastic strain at %P_DMG(Q)% kN
      PLNSOL,EPPL,EQV
    *ENDIF
    ESEL,S,TYPE,,2
    ETABLE,SBAR,LS,1
    /TITLE,Bar stress at %P_DMG(Q)% kN
    PLLS,SBAR,SBAR
    ESEL,ALL
  *ENDIF
*ENDDO
SET,LAST
/TITLE,Deformed shape near failure
PLDISP,2
/TITLE,Longitudinal stress near failure
PLNSOL,S,X
*IF,CONC,EQ,1,THEN
  /TITLE,Crack pattern near failure
  PLCRACK,1
*ENDIF
/SHOW,CLOSE
FINISH
